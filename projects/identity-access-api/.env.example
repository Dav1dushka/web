# Copy to .env and replace placeholders before starting.
DATABASE_URL=postgresql+psycopg://identity:change-this-password@db:5432/identitydb
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG
JWT_ISSUER=identity-access-api
JWT_AUDIENCE=identity-access-client
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_POSTGRES_PASSWORD
